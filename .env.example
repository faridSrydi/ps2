# ============================================================
# PS2 Cloud Gaming Platform — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://ps2user:ps2password@localhost:5432/ps2cloud?schema=public

# ─── JWT Authentication ──────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Paths ───────────────────────────────────────────────────
GAMES_DIR=/app/games
BIOS_DIR=/app/bios
SAVES_DIR=/app/saves
COVERS_DIR=/app/covers
SCREENSHOTS_DIR=/app/screenshots
CONFIG_DIR=/app/config
LOGS_DIR=/app/logs
STORAGE_DIR=/app/storage

# ─── PCSX2 ───────────────────────────────────────────────────
PCSX2_BINARY=/usr/bin/pcsx2-qt
PCSX2_CONFIG_DIR=/app/config/pcsx2
BIOS_PATH=/app/bios

# ─── Streaming ───────────────────────────────────────────────
WEBRTC_PORT_MIN=10000
WEBRTC_PORT_MAX=10100
STUN_SERVER=stun:stun.l.google.com:19302
STREAM_RESOLUTION=1280x720
STREAM_BITRATE=4000
STREAM_FPS=60

# ─── Session ─────────────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=8
SESSION_TIMEOUT_HOURS=4
SESSION_IDLE_TIMEOUT_MINUTES=30

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Admin ───────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@ps2cloud.local
