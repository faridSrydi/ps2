# ============================================================
# PS2 Cloud Gaming Platform — Systemd Service
# Install: sudo cp ps2-cloud.service /etc/systemd/system/
# Enable:  sudo systemctl enable --now ps2-cloud
# ============================================================

[Unit]
Description=PS2 Cloud Gaming Platform
Documentation=https://github.com/your-repo/ps2-cloud
After=network-online.target postgresql.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ps2-cloud
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart

# ─── Restart Policy ──────────────────────────────────────
Restart=on-failure
RestartSec=10

# ─── Resource Limits ─────────────────────────────────────
LimitNOFILE=65535
LimitNPROC=4096

# ─── Logging ─────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ps2-cloud

[Install]
WantedBy=multi-user.target
