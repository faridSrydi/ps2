// ============================================================
// PS2 Cloud Gaming Platform — Prisma Database Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum SessionStatus {
  CREATING
  RUNNING
  PAUSED
  STOPPED
  ERROR
}

enum ControllerStatus {
  PAIRED
  DISCONNECTED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ============================================================
// MODELS
// ============================================================

/// User accounts — supports admin, regular user, and guest roles
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String?   @unique
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(USER)
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")

  // Relations
  sessions      Session[]
  favorites     Favorite[]
  saveStates    SaveState[]
  recentlyPlayed RecentlyPlayed[]
  screenshots   Screenshot[]

  @@map("users")
}

/// PS2 game library — scanned from /games folder
model Game {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  filename    String
  filepath    String
  fileSize    BigInt   @map("file_size")
  format      String   // iso, bin, chd, gz, cue
  serial      String?  // e.g., SLUS-12345
  region      String?  // NTSC-U, PAL, NTSC-J
  genre       String?
  developer   String?
  publisher   String?
  releaseYear Int?     @map("release_year")
  description String?  @db.Text
  coverPath   String?  @map("cover_path")
  rating      Float?   @default(0)
  playCount   Int      @default(0) @map("play_count")
  scannedAt   DateTime @default(now()) @map("scanned_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  sessions       Session[]
  favorites      Favorite[]
  saveStates     SaveState[]
  recentlyPlayed RecentlyPlayed[]
  screenshots    Screenshot[]

  @@map("games")
}

/// Game session — created when user clicks Play
model Session {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  gameId        String        @map("game_id")
  roomId        String        @unique @map("room_id")
  status        SessionStatus @default(CREATING)
  pcsx2Pid      Int?          @map("pcsx2_pid")
  displayNumber Int?          @map("display_number")
  streamUrl     String?       @map("stream_url")
  portWebrtc    Int?          @map("port_webrtc")
  portWs        Int?          @map("port_ws")
  startedAt     DateTime      @default(now()) @map("started_at")
  endedAt       DateTime?     @map("ended_at")
  durationSecs  Int?          @map("duration_seconds")
  metadata      Json?

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  screenshots      Screenshot[]
  controllerPairs  ControllerPair[]

  @@index([userId])
  @@index([gameId])
  @@index([status])
  @@map("sessions")
}

/// User favorites
model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  gameId    String   @map("game_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("favorites")
}

/// Save states per user per game
model SaveState {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  gameId         String   @map("game_id")
  slot           Int      @default(1) // 1-10
  filepath       String
  fileSize       BigInt   @map("file_size")
  screenshotPath String?  @map("screenshot_path")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, slot])
  @@index([userId, gameId])
  @@map("save_states")
}

/// Recently played history
model RecentlyPlayed {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  gameId           String   @map("game_id")
  playDurationSecs Int      @default(0) @map("play_duration_seconds")
  playedAt         DateTime @default(now()) @map("played_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
  @@map("recently_played")
}

/// In-game screenshots captured by users
model Screenshot {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  gameId    String   @map("game_id")
  sessionId String?  @map("session_id")
  filepath  String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("screenshots")
}

/// Controller pairings per session (supports 2-player)
model ControllerPair {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  deviceId     String           @map("device_id")
  deviceName   String?          @map("device_name")
  playerNumber Int              @default(1) @map("player_number") // 1 or 2
  status       ControllerStatus @default(PAIRED)
  pairedAt     DateTime         @default(now()) @map("paired_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerNumber])
  @@map("controller_pairs")
}

/// System-wide logs for admin panel
model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  source    String   // e.g., "session", "emulator", "streaming"
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

/// Application settings (key-value store)
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
